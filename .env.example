# Meridian Orchestrator service configuration.
# Copy to .env and customize. .env is gitignored.

# Root directory for service data. Default: ~/.meridian-orchestrator
# MERIDIAN_ORCH_DATA_DIR=

# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
# MERIDIAN_ORCH_LOG_LEVEL=INFO

# MCP server bind address. Default: 127.0.0.1 (loopback only).
# Non-loopback hosts are rejected unless MERIDIAN_ORCH_MCP_ALLOW_NON_LOOPBACK=true.
# MERIDIAN_ORCH_MCP_HOST=127.0.0.1
# MERIDIAN_ORCH_MCP_PORT=8765
# MERIDIAN_ORCH_MCP_ALLOW_NON_LOOPBACK=false

# Telegram notification credentials (M6).
# Required at M6+. Service runs with notification disabled if missing.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
