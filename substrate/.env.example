# Copy to .env for docker-compose. Never commit .env.
SUBSTRATE_DB_NAME=substrate
SUBSTRATE_DB_USER=substrate
SUBSTRATE_DB_PASSWORD=change-me-locally
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
SUBSTRATE_AUTH_MODE=oidc
SUBSTRATE_OIDC_ISSUER_URI=http://keycloak:8080/realms/substrate
SUBSTRATE_ENGAGEMENT_ID=local-testing
# Optional — AI assist features degrade gracefully when absent
ANTHROPIC_API_KEY=
